# Copia este archivo como .env.local y pon los datos de tu proyecto de Supabase
# (Project Settings → API). Ambos son públicos: van en el navegador.
# NUNCA pongas aquí la "service_role key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Página de Patreon para el botón "Apoyar en Patreon" (opcional)
VITE_PATREON_URL=https://www.patreon.com/TU_PAGINA
