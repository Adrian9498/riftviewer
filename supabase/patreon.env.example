# Copia este archivo como supabase/.env.patreon (no se sube a Git) y súbelo con:
#   npx supabase secrets set --env-file supabase/.env.patreon
# Son secretos del servidor: viven en Supabase, nunca en la app.

# Patreon → portal de desarrolladores → tu cliente
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# Patreon → portal de desarrolladores → Webhooks → el secreto del webhook
PATREON_WEBHOOK_SECRET=

# Id de tu campaña y de tus niveles (ver docs/patreon.md, paso 3)
PATREON_CAMPAIGN_ID=
# Niveles de Patreon → plan de la app, del más bajo al más alto
PATREON_TIERS=[{"id":"ID_NIVEL_1","tier":"apoyo"},{"id":"ID_NIVEL_2","tier":"pro"}]

# Direcciones de la app a las que se puede volver después de conectar (separadas por coma)
APP_URLS=http://localhost:5173,http://localhost:4173
