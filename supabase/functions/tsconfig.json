{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"] }
  },
  "include": ["**/*.ts"]
}
