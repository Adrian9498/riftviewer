{
  "name": "riftbound-visualizador",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Visualizador de partidas de Riftbound para crear videos (replays de RiftAtlas y guiones).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalogo": "node scripts/actualizar-openrift.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
