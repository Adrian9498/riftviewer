{
  "name": "riftviewer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Riftviewer: visualizador de partidas de Riftbound para crear videos (replays de RiftAtlas y guiones).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p supabase/functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalogo": "node scripts/actualizar-openrift.mjs",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "supabase": "^2.122.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
